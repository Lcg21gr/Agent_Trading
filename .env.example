# OAuth secrets: private server variables, never frontend variables.
PORT=3000
HOST=0.0.0.0
CTRADER_ENV=demo
API_KEY=REPLACE_WITH_RANDOM_READ_KEY_MINIMUM_32_CHARACTERS
TRADING_API_KEY=REPLACE_WITH_DIFFERENT_RANDOM_TRADE_KEY_MINIMUM_32_CHARACTERS
TOKEN_ENCRYPTION_KEY=
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
CTRADER_ACCOUNT_LOGIN=5371977

# Keep disabled until MySQL, scope and demo account have been verified.
TRADING_ENABLED=false
ALLOWED_SYMBOLS=EURUSD
ORDER_LABEL=agent-trading-api
MAX_VOLUME_UNITS=1000
MAX_OPEN_POSITIONS=1
MAX_SPREAD_PIPS=3
MAX_STOP_LOSS_PIPS=100
MARGIN_RESERVE_PERCENT=50
# Empty permits server-to-server calls. Browser origins must be explicit HTTPS origins.
CORS_ORIGINS=

# Dedicated Hostinger MySQL database. Use the hostname supplied by hPanel.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
# Optional PEM CA for remote MySQL with verified TLS. Never disable certificate verification.
MYSQL_SSL_CA=
