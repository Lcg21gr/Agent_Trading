{
  "openapi": "3.0.3",
  "info": {
    "title": "Agent Trading cTrader Demo API",
    "version": "0.2.0",
    "description": "Explicit HTTP trading instructions for one verified demo account. OpenAPI is the interface source of truth; docs/api-contract.md explains operational guarantees. No real-money accounts. Query and execution credentials are independent. Never embed either key in a public frontend."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development; use HTTPS on Hostinger"
    }
  ],
  "tags": [
    {
      "name": "Queries",
      "description": "Broker reads and validations"
    },
    {
      "name": "Trading",
      "description": "Explicit demo execution and reconciliation"
    }
  ],
