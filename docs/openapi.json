  "components": {
    "schemas": {
      "OrderRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "side",
          "volume",
          "stopLossPips",
          "takeProfitPips"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "pattern": "^[A-Z0-9._-]{1,32}$",
            "example": "EURUSD"
          },
          "side": {
            "type": "string",
            "enum": [
              "BUY",
              "SELL"
            ]
          },
          "volume": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,8})(\\.[0-9]{1,2})?$",
            "description": "Positive instrument units, not lots.",
            "example": "1000"
          },
          "stopLossPips": {
            "type": "string",
            "example": "10",
            "description": "Positive pips, up to two decimals; broker precision and configured maximum also apply."
          },
          "takeProfitPips": {
            "type": "string",
            "example": "20",
            "description": "Positive pips, up to two decimals."
          }
        }
      },
      "Operation": {
        "type": "object",
        "required": [
          "operationId",
          "status"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "open",
              "close"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "reserved",
              "sent",
              "completed",
              "rejected",
              "uncertain"
            ]
          },
          "createdAt": {
            "type": "integer",
            "format": "int64"
          },
          "updatedAt": {
            "type": "integer",
            "format": "int64"
          },
          "result": {
            "type": "object",
            "nullable": true,
            "additionalProperties": true
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error",
          "requestId"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Empty": {
        "type": "object",
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "ReadKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "API_KEY: read and preview access"
      },
      "TradingKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "TRADING_API_KEY: execution and read access"
      }
    },
    "responses": {
      "Error400": {
        "description": "Invalid input",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error401": {
        "description": "Bearer authentication required",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error403": {
        "description": "Insufficient scope, disabled trading or forbidden origin",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error404": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error429": {
        "description": "Account busy or request rate limited",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error502": {
        "description": "Broker authentication, transport or verification failed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error503": {
        "description": "Durable storage required or unavailable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error409": {
        "description": "Conflicting idempotency key or unresolved operation",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error413": {
        "description": "Body exceeds 8192 bytes",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error415": {
        "description": "Content-Type must be application/json",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ValidationError": {
        "description": "Operation rule not met",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
